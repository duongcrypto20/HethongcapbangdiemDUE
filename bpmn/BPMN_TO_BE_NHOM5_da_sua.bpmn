    <bpmn:subProcess id="EventSub_SVChuDongHuy" name="Ngoại lệ: sinh viên chủ động hủy yêu cầu" triggeredByEvent="true">
      <bpmn:documentation>Sự kiện thông điệp phát sinh khi sinh viên yêu cầu hủy trên ứng dụng web trong lúc hồ sơ còn đang xử lý. Sub-process hủy các hoạt động đang chờ, cập nhật trạng thái, lưu vết và gửi xác nhận hủy.</bpmn:documentation>
      <bpmn:startEvent id="Start_NhanThongDiepHuy" name="SV yêu cầu hủy">
        <bpmn:outgoing>Flow_EventStart_Huy</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageDef_YeuCauHuy" messageRef="Message_SVYeuCauHuy" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_EventCapNhatHuy" name="Hủy hồ sơ và ghi nhật ký">
        <bpmn:incoming>Flow_EventStart_Huy</bpmn:incoming>
        <bpmn:outgoing>Flow_EventHuy_GuiEmail</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="Task_EventGuiThongBaoHuy" name="Gửi xác nhận đã hủy">
        <bpmn:incoming>Flow_EventHuy_GuiEmail</bpmn:incoming>
        <bpmn:outgoing>Flow_EventGuiEmail_KetThuc</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_EventHuy" name="Yêu cầu đã hủy (SV chủ động)">
        <bpmn:incoming>Flow_EventGuiEmail_KetThuc</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_EventStart_Huy" sourceRef="Start_NhanThongDiepHuy" targetRef="Task_EventCapNhatHuy" />
      <bpmn:sequenceFlow id="Flow_EventHuy_GuiEmail" sourceRef="Task_EventCapNhatHuy" targetRef="Task_EventGuiThongBaoHuy" />
      <bpmn:sequenceFlow id="Flow_EventGuiEmail_KetThuc" sourceRef="Task_EventGuiThongBaoHuy" targetRef="End_EventHuy" />
    </bpmn:subProcess>
