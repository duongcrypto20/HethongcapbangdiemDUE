# Sao chép thành tệp .env rồi điền giá trị thật. Tệp .env đã nằm trong .gitignore.

# Passphrase mã hóa khóa bí mật ký số (keys/signing_key.pem). BẮT BUỘC đổi khi triển khai thật.
SIGN_KEY_PASSPHRASE=doi-passphrase-nay-khi-trien-khai

# Khóa ký cookie phiên đăng nhập (để trống: tự sinh và cất trong keys/flask_secret.txt)
FLASK_SECRET_KEY=

# Cơ sở dữ liệu Turso (để trống thì dùng SQLite local)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Khóa riêng PEM đã mã hóa, Base64; cần cấu hình cố định khi chạy trên Vercel
SIGNING_PRIVATE_KEY_B64=

# Chế độ demo: hiện danh sách tài khoản mẫu ở trang đăng nhập và nút tua đồng hồ (0 để tắt)
DEMO_MODE=1
DEMO_PASSWORD=123456

# Gửi email thật qua SMTP (để trống SMTP_HOST thì chỉ lưu vào hộp thư hệ thống)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Khi demo: chuyển mọi email tới một địa chỉ của nhóm thay vì email sinh viên
SMTP_REDIRECT_TO=

# Máy chủ
HOST=127.0.0.1
PORT=5000
